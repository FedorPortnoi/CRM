# EAS upload ignore list. Mirrors .gitignore, EXCEPT it force-includes
# google-services.json (gitignored, but required by managed Android builds)
# and always ignores local native projects so EAS prebuilds from app.json.

# Dependencies
node_modules/
.pnp
.pnp.js

# Environment — never upload secrets
.env
.env.local
.env.*.local
# .easignore REPLACES .gitignore for EAS uploads — it does not stack on top of
# it. Every secret rule in .gitignore therefore has to be repeated here or the
# file ships to Expo's build servers. This block drifted once already:
# .gitignore gained `.env.bak*` on 28 Jul, this file did not, and
# .env.bak-20260727 (41 credentials) was uploaded on every build until 30 Jul.
.env.bak*
.env.production
*.pem
*.p8
*.jks
*.keystore
credentials.json
*service-account*.json
google-play-service-account.json
id_rsa*
*.key
backend-log.txt
firebase-service-account.json
google-services.json

# Build outputs
dist/
build/
web-build/
.expo/
.expo-shared/
ios/build/
android/build/
android/.gradle/
coverage/

# Release artifacts
*.apk
*.aab
*.ipa
*.pem

# Sensitive
certs/
docs/Российские*
docs/*доступы*

# Logs
*.log
npm-debug.log*
yarn-debug.log*

# Local run artifacts
/codex-*.txt
/codex-*.md
/tmp-*.txt
/tmp-test-runs/

# OS / IDE
.DS_Store
Thumbs.db
.vscode/
.idea/

# TypeScript / tooling
*.tsbuildinfo
.turbo/

# Playwright
tests/smoke/.auth.json
test-results/
playwright-report/

expo-env.d.ts

# Always use EAS managed prebuild (ignore any locally-generated native projects)
/android/
/ios/

# Force-include the Firebase Android config the managed build needs
!google-services.json

# Local self-hosted production env. Holds the real JWT secret, the field
# encryption key and the database password — the same secrets as the server's
# .env. Ignored in BOTH files, because .easignore replaces .gitignore for EAS
# uploads rather than stacking on it.
.env.localprod
.env.local-prod
