// Prisma schema for Mobile CRM Platform
// Prisma 5.13.0 | Yandex Managed PostgreSQL (ru-central1)

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

// Ordered loosely by breadth of power, but the ordering carries no meaning —
// authorization comes from backend/services/capabilities.ts, never from the
// position of a value here. Adding a role is additive and safe; REMOVING one is
// not, because existing rows would reference a dropped label.
//
// A role says what a user may DO. What they may SEE is the separate
// manager_id hierarchy (see visibility.ts) — do not encode org structure here.
enum UserRole {
  owner
  admin
  head        // РОП / руководитель отдела — sales powers, reach via manager_id
  member      // менеджер по продажам
  accountant  // бухгалтер — org-wide read of money, no writes
  marketer    // маркетолог — campaigns org-wide, no pipeline writes
  support     // поддержка — contact record and activity only
  viewer
}

enum OrgPlan {
  starter
  growth
  business
}

enum ContactType {
  lead
  customer
  partner
  other
}

enum ContactStatus {
  active
  inactive
  archived
}

enum DealStatus {
  open
  won
  lost
  archived
}

enum TaskPriority {
  low
  medium
  high
  urgent
}

enum TaskStatus {
  pending
  in_progress
  done
  cancelled
}

enum MessageDirection {
  inbound
  outbound
}

enum MessageChannel {
  in_app
  email
  call
}

enum MessageStatus {
  pending
  sent
  delivered
  read
  failed
}

enum CalendarEventStatus {
  scheduled
  completed
  cancelled
}

enum WorkflowStatus {
  active
  paused
  archived
}

enum WorkflowTrigger {
  contact_created
  deal_stage_changed
  task_completed
  deal_won
  deal_created
  task_created
  deal_stale
}

enum WorkflowRunStatus {
  success
  failed
}

enum PendingCaptureType {
  call
  email
}

enum PendingCaptureStatus {
  pending
  matched
  dismissed
}

enum WebhookStatus {
  active
  paused
}

enum WebhookDeliveryStatus {
  pending
  success
  failed
}

enum SequenceStatus {
  draft
  active
  paused
  archived
}

enum SequenceEnrollmentStatus {
  active
  completed
  unsubscribed
  failed
  cancelled
}

enum EmailSendStatus {
  queued
  sent
  failed
  opened
}

enum AssistantMessageRole {
  user
  assistant
  tool
}

// ---------------------------------------------------------------------------
// Models
// ---------------------------------------------------------------------------

model User {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id   String    @db.Uuid
  email             String?   @unique @db.Citext
  username          String?   @db.Citext
  password_hash     String
  name              String
  role              UserRole  @default(member)
  avatar_url        String?
  phone             String?
  // IANA zone name. Every reminder this user schedules is interpreted here, so a
  // wall-clock "09:00" means 09:00 where they are rather than 09:00 UTC — the whole
  // point of letting them pick a time at all. Defaults to the market's zone; see
  // DEFAULT_TIME_ZONE in backend/config/market.ts.
  timezone               String    @default("Europe/Moscow")
  is_active              Boolean   @default(true)
  onboarding_state       Json?
  preferences            Json?
  last_seen_at           DateTime?
  invited_by             String?   @db.Uuid
  manager_id             String?   @db.Uuid
  created_at             DateTime  @default(now())
  updated_at             DateTime  @updatedAt
  push_token             String?
  failed_login_count     Int       @default(0)
  locked_until           DateTime?
  is_verified            Boolean   @default(false)
  phone_verified         Boolean   @default(false)
  email_verified         Boolean   @default(false)
  must_change_password   Boolean   @default(false)
  must_change_email      Boolean   @default(false)

  // Relations
  organization     Org       @relation("UserOrg", fields: [organization_id], references: [id])
  inviter          User?     @relation("UserInviter", fields: [invited_by], references: [id])
  invitees         User[]    @relation("UserInviter")
  manager          User?     @relation("UserManager", fields: [manager_id], references: [id])
  reports          User[]    @relation("UserManager")
  ownedOrgs        Org[]     @relation("OrgOwner")
  assignedContacts Contact[] @relation("ContactAssignedTo")
  createdContacts  Contact[] @relation("ContactCreatedBy")
  assignedDeals    Deal[]    @relation("DealAssignedTo")
  createdDeals     Deal[]    @relation("DealCreatedBy")
  assignedTasks    Task[]    @relation("TaskAssignedTo")
  createdTasks     Task[]    @relation("TaskCreatedBy")
  completedTasks        Task[]              @relation("TaskCompletedBy")
  messages              Message[]
  calendarEventsCreated CalendarEvent[]     @relation("CalendarEventCreatedBy")
  calendarSyncs         UserCalendarSync[]
  createdPipelines      Pipeline[]          @relation("PipelineCreatedBy")
  createdWorkflows      Workflow[]          @relation("WorkflowCreatedBy")
  authSessions          AuthSession[]
  auditEvents           AuditEvent[]
  activityLogs          ActivityLog[] @relation("ActivityLogUser")
  uploadedAttachments   Attachment[]  @relation("AttachmentUploader")
  verificationCodes     VerificationCode[]
  chatMessages          ChatMessage[]      @relation("ChatMessageSender")
  chatReadReceipts      ChatReadReceipt[]  @relation("ChatReadReceiptUser")
  notifications         Notification[]     @relation("NotificationRecipient")
  createdApiKeys        ApiKey[]           @relation("ApiKeyCreatedBy")
  createdWebhookEndpoints WebhookEndpoint[] @relation("WebhookEndpointCreatedBy")
  createdEmailTemplates   EmailTemplate[]        @relation("EmailTemplateCreatedBy")
  createdSequences        Sequence[]             @relation("SequenceCreatedBy")
  sequenceEnrollments     SequenceEnrollment[]   @relation("SequenceEnrollmentEnrolledBy")
  assistantConversations  AssistantConversation[] @relation("AssistantConversationUser")
  createdInvites          Invite[]               @relation("InviteCreatedBy")
  acceptedInvite          Invite[]               @relation("InviteAcceptedBy")
  pushDevices             PushDevice[]           @relation("PushDeviceUser")
  taskReminders           TaskReminder[]         @relation("TaskReminderRecipient")
  connectedAmoIntegrations AmoIntegration[]      @relation("AmoIntegrationConnectedBy")
  createdLeadInboxes       LeadInbox[]           @relation("LeadInboxCreatedBy")

  // Employees log in by username, which only needs to be unique inside their org.
  @@unique([organization_id, username])
  @@index([manager_id])
}

model Org {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name          String
  slug          String   @unique
  plan          OrgPlan  @default(starter)
  owner_id      String?  @db.Uuid
  settings      Json?
  plan_features           Json?
  stalled_threshold_days  Int     @default(30)
  decay_factor            Float   @default(0.5)
  join_code               String?   @unique
  join_code_expires_at    DateTime?
  created_at              DateTime @default(now())
  updated_at              DateTime @updatedAt

  // Relations
  owner    User?     @relation("OrgOwner", fields: [owner_id], references: [id])
  users    User[]    @relation("UserOrg")
  contacts Contact[]
  deals    Deal[]
  tasks          Task[]
  messages       Message[]
  calendarEvents CalendarEvent[]
  pipelines       Pipeline[]
  workflows       Workflow[]
  pendingCaptures PendingCapture[]
  authSessions    AuthSession[]
  auditEvents     AuditEvent[]
  activityLogs    ActivityLog[]
  attachments     Attachment[]
  chatMessages    ChatMessage[]  @relation("ChatMessageOrg")
  notifications   Notification[] @relation("NotificationOrg")
  apiKeys          ApiKey[]
  webhookEndpoints WebhookEndpoint[]
  webhookDeliveries WebhookDelivery[]
  idempotencyKeys  IdempotencyKey[]
  emailTemplates         EmailTemplate[]
  sequences              Sequence[]
  sequenceSteps          SequenceStep[]
  sequenceEnrollments    SequenceEnrollment[]
  emailSends             EmailSend[]
  assistantConversations AssistantConversation[]
  assistantMessages      AssistantMessage[]
  invites                Invite[]
  taskReminders          TaskReminder[]
  amoIntegration         AmoIntegration?
  amoEntityMaps          AmoEntityMap[]
  amoSyncJobs            AmoSyncJob[]
  amoSyncConflicts       AmoSyncConflict[]
  leadInbox              LeadInbox?
  leadInboxMessages      LeadInboxMessage[]

  @@map("organizations")
}

model AuthSession {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id String    @db.Uuid
  user_id         String    @db.Uuid
  token_hash      String    @unique
  user_agent      String?
  ip_address      String?
  revoked_at      DateTime?
  revoked_reason  String?
  last_seen_at    DateTime?
  expires_at      DateTime?
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt

  organization Org  @relation(fields: [organization_id], references: [id])
  user         User @relation(fields: [user_id], references: [id])

  @@index([user_id, revoked_at])
  @@index([organization_id, created_at])
}

model AuditEvent {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id String?  @db.Uuid
  user_id         String?  @db.Uuid
  action          String
  outcome         String   @default("success")
  target_type     String?
  target_id       String?
  ip_address      String?
  user_agent      String?
  metadata        Json?
  created_at      DateTime @default(now())

  organization Org?  @relation(fields: [organization_id], references: [id])
  user         User? @relation(fields: [user_id], references: [id])

  @@index([organization_id, created_at])
  @@index([user_id, created_at])
  @@index([action, created_at])
}

model Contact {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id String        @db.Uuid
  first_name      String
  last_name       String?
  company         String?
  email           String?
  /// HMAC-SHA256 hex of the normalized email — lets encrypted PII stay searchable
  email_bidx      String?       @db.Text
  phone           String?
  /// HMAC-SHA256 hex of the normalized phone — lets encrypted PII stay searchable
  phone_bidx      String?       @db.Text
  mobile          String?
  /// HMAC-SHA256 hex of the normalized mobile — lets encrypted PII stay searchable
  mobile_bidx     String?       @db.Text
  address         Json?
  /// Stored as a JSON array (mirrors PostgreSQL text[] column)
  tags            Json?
  source          String?
  notes           String?
  avatar_url      String?
  assigned_to     String?       @db.Uuid
  type            ContactType   @default(lead)
  status          ContactStatus @default(active)
  custom_fields   Json?
  is_example_data Boolean       @default(false)
  /// ФЗ-38 «О рекламе» ст. 18 — advertising mailings require PRIOR consent and fines
  /// are per message, so these five columns ARE the legal evidence. Never send unless
  /// marketing_consent = true AND unsubscribed_at IS NULL.
  marketing_consent        Boolean   @default(false)
  marketing_consent_at     DateTime?
  /// How consent was obtained: form, import, verbal, contract, ...
  marketing_consent_source String?
  unsubscribed_at          DateTime?
  /// Unguessable token for one-click unsubscribe links (no auth required)
  unsubscribe_token        String?   @unique
  created_by      String?       @db.Uuid
  created_at      DateTime      @default(now())
  updated_at      DateTime      @updatedAt

  // Relations
  organization Org      @relation(fields: [organization_id], references: [id])
  assignee     User?    @relation("ContactAssignedTo", fields: [assigned_to], references: [id])
  creator      User?    @relation("ContactCreatedBy", fields: [created_by], references: [id])
  deals           Deal[]
  tasks           Task[]
  messages        Message[]
  calendarEvents  CalendarEvent[]
  pendingCaptures PendingCapture[]
  sequenceEnrollments SequenceEnrollment[]
  emailSends          EmailSend[]

  @@index([organization_id, status])
  @@index([organization_id, created_at])
  @@index([organization_id, email_bidx])
  @@index([organization_id, phone_bidx])
  @@index([organization_id, mobile_bidx])
  @@index([email_bidx])
  @@index([phone_bidx])
  @@index([mobile_bidx])
  // The sequence sender filters on exactly this triple before queueing a message.
  @@index([organization_id, marketing_consent, unsubscribed_at])
}

model Deal {
  id              String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id String     @db.Uuid
  title           String
  contact_id      String?    @db.Uuid
  pipeline_id     String?    @db.Uuid
  stage_id        String?    @db.Uuid
  value           Decimal?
  currency        String?    @default("RUB")
  expected_close  DateTime?
  actual_close    DateTime?
  probability     Int?
  status          DealStatus @default(open)
  lost_reason     String?
  next_action      String?
  next_action_due  DateTime?
  stage_entered_at DateTime   @default(now())
  source          String?
  assigned_to     String?    @db.Uuid
  custom_fields   Json?
  is_example_data Boolean    @default(false)
  created_by      String?    @db.Uuid
  created_at      DateTime   @default(now())
  updated_at      DateTime   @updatedAt

  // Relations
  organization Org      @relation(fields: [organization_id], references: [id])
  contact      Contact? @relation(fields: [contact_id], references: [id])
  assignee       User?           @relation("DealAssignedTo", fields: [assigned_to], references: [id])
  creator        User?           @relation("DealCreatedBy", fields: [created_by], references: [id])
  pipeline       Pipeline?       @relation(fields: [pipeline_id], references: [id])
  stage          PipelineStage?  @relation(fields: [stage_id], references: [id])
  tasks          Task[]
  calendarEvents CalendarEvent[]

  @@index([organization_id, status])
  @@index([organization_id, created_at])
  @@index([organization_id, contact_id])
  @@index([organization_id, pipeline_id])
}

model Task {
  id              String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id String       @db.Uuid
  title           String
  description     String?
  contact_id      String?      @db.Uuid
  deal_id         String?      @db.Uuid
  assigned_to     String       @db.Uuid
  created_by      String?      @db.Uuid
  due_date        DateTime?
  priority        TaskPriority @default(medium)
  status          TaskStatus   @default(pending)
  is_recurring    Boolean      @default(false)
  recurrence_rule String?
  reminder_at     DateTime?
  completed_at    DateTime?
  completed_by    String?      @db.Uuid
  is_example_data Boolean      @default(false)
  created_at      DateTime     @default(now())
  updated_at      DateTime     @updatedAt

  // Relations
  organization Org      @relation(fields: [organization_id], references: [id])
  contact      Contact? @relation(fields: [contact_id], references: [id])
  deal         Deal?    @relation(fields: [deal_id], references: [id])
  assignee     User     @relation("TaskAssignedTo", fields: [assigned_to], references: [id])
  creator      User?    @relation("TaskCreatedBy", fields: [created_by], references: [id])
  completer    User?    @relation("TaskCompletedBy", fields: [completed_by], references: [id])
  reminders    TaskReminder[]

  @@index([organization_id, status, due_date])
  @@index([organization_id, created_at])
  @@index([organization_id, contact_id])
  @@index([organization_id, deal_id])
}

model Message {
  id              String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id String           @db.Uuid
  contact_id      String           @db.Uuid
  user_id         String?          @db.Uuid
  direction       MessageDirection
  channel         MessageChannel
  body            String
  status          MessageStatus    @default(pending)
  error_message   String?
  twilio_sid      String?
  read_at         DateTime?
  delivered_at    DateTime?
  created_at      DateTime         @default(now())

  // Relations
  organization Org      @relation(fields: [organization_id], references: [id])
  contact      Contact  @relation(fields: [contact_id], references: [id])
  user         User?    @relation(fields: [user_id], references: [id])

  @@index([organization_id, created_at])
  @@index([organization_id, contact_id, created_at])
}

model CalendarEvent {
  id                    String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id       String              @db.Uuid
  title                 String
  description           String?
  contact_id            String?             @db.Uuid
  deal_id               String?             @db.Uuid
  created_by            String?             @db.Uuid
  attendee_ids          Json?
  start_time            DateTime
  end_time              DateTime
  location              String?
  meeting_url           String?
  reminder_minutes      Int                 @default(30)
  status                CalendarEventStatus @default(scheduled)
  notes                 String?
  completed_at          DateTime?
  post_meeting_prompted Boolean             @default(false)
  ext_event_uid         String?
  ext_calendar_uid      String?
  is_example_data       Boolean             @default(false)
  created_at            DateTime            @default(now())
  updated_at            DateTime            @updatedAt

  // Relations
  organization Org      @relation(fields: [organization_id], references: [id])
  contact      Contact? @relation(fields: [contact_id], references: [id])
  deal         Deal?    @relation(fields: [deal_id], references: [id])
  creator      User?    @relation("CalendarEventCreatedBy", fields: [created_by], references: [id])

  @@index([organization_id, status, start_time])
  @@index([organization_id, created_at])
  @@index([organization_id, contact_id])
  @@index([organization_id, deal_id])
}

model UserCalendarSync {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id             String    @db.Uuid
  provider            String
  access_token        String
  refresh_token       String?
  expires_at          DateTime?
  ext_calendar_uid    String?
  yandex_username     String?
  yandex_calendar_slug String?
  created_at          DateTime  @default(now())
  updated_at          DateTime  @updatedAt

  // Relations
  user User @relation(fields: [user_id], references: [id])

  @@unique([user_id, provider])
}

model Pipeline {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id String   @db.Uuid
  name            String
  description     String?
  is_default      Boolean  @default(false)
  created_by      String?  @db.Uuid
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  // Relations
  organization Org             @relation(fields: [organization_id], references: [id])
  creator      User?           @relation("PipelineCreatedBy", fields: [created_by], references: [id])
  stages       PipelineStage[]
  deals        Deal[]
}

model PipelineStage {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  pipeline_id   String   @db.Uuid
  name          String
  position      Int
  color         String?
  is_won_stage  Boolean  @default(false)
  is_lost_stage Boolean  @default(false)
  // Per-stage close probability, offered as the default when a deal lands here.
  probability      Int?
  // Overrides Org.stalled_threshold_days for this stage: "Согласование договора"
  // legitimately sits for weeks where "Новый лид" should not.
  stale_after_days Int?
  // Retiring a stage that carries history must not delete the history. Archived
  // stages disappear from pickers and the kanban but keep their deals readable.
  is_archived      Boolean  @default(false)
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  // Relations
  pipeline Pipeline @relation(fields: [pipeline_id], references: [id])
  deals    Deal[]
}

model Workflow {
  id              String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id String          @db.Uuid
  name            String
  description     String?
  trigger         WorkflowTrigger
  conditions      Json?
  actions         Json
  status          WorkflowStatus  @default(active)
  created_by      String?         @db.Uuid
  created_at      DateTime        @default(now())
  updated_at      DateTime        @updatedAt

  organization Org           @relation(fields: [organization_id], references: [id])
  creator      User?         @relation("WorkflowCreatedBy", fields: [created_by], references: [id])
  runs         WorkflowRun[]

  @@index([organization_id, status, trigger])
}

model WorkflowRun {
  id                String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workflow_id       String            @db.Uuid
  organization_id   String            @db.Uuid
  trigger_record_id String?
  status            WorkflowRunStatus
  error_message     String?
  created_at        DateTime          @default(now())

  workflow Workflow @relation(fields: [workflow_id], references: [id])

  @@index([organization_id, created_at])
  @@index([workflow_id, created_at])
}

// phone_number here is deliberately NOT encrypted, unlike Contact.phone/mobile. A review
// proposed encrypting it; it was examined and rejected, because half-applying it is worse
// than leaving it in the clear:
//
//   - There is no phone_number_bidx column on this model, and BlindIndexKind in
//     services/encryption.ts has exactly three kinds (email/phone/mobile), each mapped 1:1
//     onto a Contact column. Encrypting with no index makes a capture unmatchable by number.
//   - Ciphertext does not fail loudly if it reaches blindIndex(). That function normalizes
//     by stripping non-digits, and "enc:v1:…" still contains digits, so it hashes to a
//     plausible-looking hex string instead of returning null. Worse, encryptField uses a
//     random IV per call, so one number yields a different bogus hash every time — the
//     contact ends up permanently unfindable by phone rather than visibly broken.
//   - Encrypting this column alone would not remove the number from the database anyway.
//     The same capture phone sits in clear in three places:
//       1. this column, written by POST /captures (controllers/captures.ts create)
//       2. raw_data below — the phone/from/From keys that resolveRawPhoneNumber reads
//       3. Message.body, which embeds the number verbatim when an email capture carries no
//          body text (resolveMessageBody); that row is written when the capture is matched
//
// A capture is short-lived pre-contact data that has to stay joinable by raw number, and it
// is protected by org scoping rather than field encryption. If it ever must be encrypted,
// all three locations move together and a phone_number_bidx column plus a capture-scoped
// BlindIndexKind land in the SAME migration — never one of them on its own.
model PendingCapture {
  id           String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  org_id       String                @db.Uuid
  type         PendingCaptureType
  raw_data     Json
  phone_number String?
  status       PendingCaptureStatus  @default(pending)
  contact_id   String?               @db.Uuid
  created_at   DateTime              @default(now())

  org     Org      @relation(fields: [org_id], references: [id])
  contact Contact? @relation(fields: [contact_id], references: [id])

  @@index([org_id, status])
  @@index([org_id, created_at])
}

model ActivityLog {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id String   @db.Uuid
  user_id         String?  @db.Uuid
  entity_type     String
  entity_id       String   @db.Uuid
  action          String
  changes         Json?
  created_at      DateTime @default(now())
  organization Org   @relation(fields: [organization_id], references: [id])
  user         User? @relation("ActivityLogUser", fields: [user_id], references: [id])
  @@index([organization_id, entity_type, entity_id])
  @@index([organization_id, created_at])
}
model Attachment {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id String   @db.Uuid
  entity_type     String
  entity_id       String   @db.Uuid
  filename        String
  file_url        String
  size            Int?
  mime_type       String?
  uploaded_by     String?  @db.Uuid
  created_at      DateTime @default(now())
  organization Org   @relation(fields: [organization_id], references: [id])
  uploader     User? @relation("AttachmentUploader", fields: [uploaded_by], references: [id])
  @@index([organization_id, entity_type, entity_id])
}

/// A pending co-worker invitation, delivered as a link.
///
/// No User row exists until the invite is accepted. A half-created account
/// sitting in the team list with no credentials is a login target nobody is
/// watching; keeping the pending state here means an unaccepted invite cannot be
/// signed into, only redeemed.
///
/// THREE SECRETS, because the link has to survive three different journeys:
///
///   token_hash     the link itself. 32 bytes, carried in the URL FRAGMENT so it
///                  never reaches nginx logs, Referer headers, or the link-preview
///                  bots that fetch every URL posted into a messenger.
///   handoff_hash   minted when the landing page opens. Rides through the store
///                  install as the RuStore `referrerId`, or via the clipboard on
///                  iOS. Separate from the link token because this one DOES travel
///                  in a query string to rustore.ru and lands in their logs.
///   claim_hash     six typeable characters, the floor for when every automatic
///                  path fails. Short-lived precisely because it is short.
///
/// All three are stored as SHA-256. Reading this table gives an attacker nothing
/// to redeem.
model Invite {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id String    @db.Uuid
  /// Whom the owner typed in. Shown on the landing page so the recipient can tell
  /// a real invite from a forwarded one meant for somebody else.
  name            String
  /// Bound at mint. The recipient never sends a role, or the link becomes an
  /// escalation primitive for whoever forwards it.
  role            UserRole
  created_by      String    @db.Uuid

  token_hash       String    @unique
  /// Traded for a lookup only. Never resolves an accept — see invites.ts.
  handoff_hash     String?   @unique
  /// UNIQUE, and that is not symmetry with the other three — it is the only
  /// thing that makes the claim-code lookup single-tenant.
  ///
  /// That lookup is unauthenticated, so it has no organization_id to put in the
  /// WHERE: a typed code is matched against every invite in the product. While
  /// this column was a bare `String?` the safety argument was silently "no two
  /// live 6-character codes are ever equal anywhere", which is an assumption
  /// about 2^30 values and not a fact — and its failure mode was the worst
  /// available, because Postgres would hand back whichever row it reached first
  /// and the invitee would be minted an accept token for a company that never
  /// invited them. Being unindexed as well, it was a sequential scan over the
  /// whole table on an endpoint anyone on the internet can call 20 times per
  /// quarter hour. One @unique closes both: it makes the assumption true and it
  /// is the index.
  ///
  /// Uniqueness that is enforced has to be uniqueness that is handled, so `open`
  /// draws again on a collision rather than surfacing a 500, and the claim
  /// branch of `lookup` still refuses a multi-row match rather than choosing —
  /// this constraint is not deployed everywhere the code is.
  claim_hash       String?   @unique
  claim_expires_at DateTime?
  /// Minted by a successful lookup, spent by accept. Its own column so that a
  /// secret which has been through RuStore's logs or the clipboard can never
  /// create an account on its own.
  accept_hash      String?   @unique
  accept_expires_at DateTime?

  expires_at      DateTime
  /// First open of the landing page. Also the moment the handoff pair is minted.
  opened_at       DateTime?
  /// Set when credentials are accepted. Consumption is atomic on this column.
  consumed_at     DateTime?
  user_id         String?   @db.Uuid
  revoked_at      DateTime?

  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt

  organization Org   @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  creator      User  @relation("InviteCreatedBy", fields: [created_by], references: [id])
  user         User? @relation("InviteAcceptedBy", fields: [user_id], references: [id])

  @@index([organization_id, consumed_at])
}

model VerificationCode {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String    @db.Uuid
  code_hash  String
  channel    String
  expires_at DateTime
  used_at    DateTime?
  created_at DateTime  @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

