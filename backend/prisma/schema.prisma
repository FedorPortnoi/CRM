  messages     AssistantMessage[]

  @@index([organization_id, user_id, updated_at(sort: Desc)])
  @@index([organization_id, created_at])
}

model AssistantMessage {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // Intra-turn ordering. Every message of one assistant turn is written inside a
  // single transaction, so created_at is the SAME CURRENT_TIMESTAMP on all of
  // them and the random-UUID primary key is no tiebreaker. seq is BIGSERIAL:
  // nextval() is claimed per INSERT, so it records true insertion order and is
  // the only column replay may order by. Never select it into an API response —
  // Prisma maps BigInt to a JS bigint, which JSON.stringify refuses.
  seq             BigInt               @default(autoincrement())
  organization_id String               @db.Uuid
  conversation_id String               @db.Uuid
  role            AssistantMessageRole
  content         String
  tool_calls      Json?
  created_at      DateTime             @default(now())

  organization Org                   @relation(fields: [organization_id], references: [id])
  conversation AssistantConversation @relation(fields: [conversation_id], references: [id], onDelete: Cascade)

  @@index([conversation_id, seq])
  @@index([organization_id, created_at])
}

// ─── Reminders ────────────────────────────────────────────────────────────────

enum ReminderFrequency {
  once
  daily
  weekdays
  weekly
  custom
}

/// A repeating reminder schedule attached to a task.
///
/// Task.reminder_at survives as the one-shot field the public API and the client's local
/// notification still read; this table is what the scheduler actually scans. Separating them
/// is what allows more than one rule per task (the assignee at 09:00 daily, their manager
/// once on the due date) without widening Task for every future variation.
///
/// next_fire_at is materialized rather than computed per tick: the scheduler's hot query is
/// "everything due", and that has to be an index seek, not a recurrence-rule evaluation over
/// every active reminder in the database.
model TaskReminder {
  id              String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  task_id         String            @db.Uuid
  organization_id String            @db.Uuid
  recipient_id    String            @db.Uuid
  frequency       ReminderFrequency
  /// Wall-clock local time, "HH:MM". Text on purpose — the instant it maps to moves with the
  /// calendar (DST), so the only stable thing to persist is what the user actually said.
  time_of_day     String
  /// For `weekly`: ISO weekdays, 1 = Monday .. 7 = Sunday. Empty for every other frequency.
  days_of_week    Int[]
  /// For `custom`: an RRULE string, evaluated in `timezone`.
  recurrence_rule String?
  /// Snapshot of the recipient's zone when the rule was written. Held per-reminder rather than
  /// read live from User, so moving an employee between zones does not silently reschedule
  /// every reminder they already agreed to.
  timezone        String
  starts_at       DateTime
  /// "How long this task is valuable." Past it the reminder deactivates itself.
  expires_at      DateTime?
  /// The next instant this should fire, in UTC. Null means exhausted.
  next_fire_at    DateTime?
  last_fired_at   DateTime?
  fire_count      Int               @default(0)
  is_active       Boolean           @default(true)
  created_at      DateTime          @default(now())
  updated_at      DateTime          @updatedAt

  task         Task @relation(fields: [task_id], references: [id], onDelete: Cascade)
  organization Org  @relation(fields: [organization_id], references: [id])
  recipient    User @relation("TaskReminderRecipient", fields: [recipient_id], references: [id])

  /// The scheduler's only query.
  @@index([is_active, next_fire_at])
  @@index([task_id])
  @@index([organization_id, recipient_id])
}

/// One row per (device, transport).
///
/// Replaces User.push_token, which held exactly one token and recorded nothing about which
/// service that token belongs to. Both assumptions broke: a user has a phone and a tablet, and
/// Android has to leave FCM for RuStore while iOS stays on APNs, so the transport is now a
/// property of the token rather than of the build.
///
/// User.push_token is deliberately NOT dropped in this migration — it is backfilled from and
/// kept in step for one release, so a rollback does not silence every notification.
model PushDevice {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id      String   @db.Uuid
  token        String   @unique
  /// 'rustore' | 'apns' | 'expo' | 'fcm'
  provider     String
  /// 'android' | 'ios' | 'web'
  platform     String
  app_version  String?
  device_name  String?
  last_seen_at DateTime @default(now())
  created_at   DateTime @default(now())

  user User @relation("PushDeviceUser", fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([provider])
}

// ─── amoCRM ───────────────────────────────────────────────────────────────────

enum AmoIntegrationStatus {
  active
  needs_reauth
  paused
}

enum AmoSyncDirection {
  inbound
  outbound
}

enum AmoSyncJobStatus {
  pending
  processing
  delivered
  failed
  dropped
}

/// One amoCRM account bound to one organization.
///
/// THE REFRESH TOKEN ROTATES ON EVERY REFRESH. amoCRM issues a new refresh token with each
/// access-token renewal and invalidates the old one immediately, so two concurrent renewals
/// both presenting the stored token means the loser's response is worthless and the account is
/// locked out for good — re-authorization by hand is the only way back. Every read-modify-write
/// of these columns must therefore take a row lock (SELECT ... FOR UPDATE) or an advisory lock
/// keyed on organization_id, and must persist the new refresh token in the same transaction
/// that consumed the old one.
model AmoIntegration {
  id                String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id   String               @unique @db.Uuid
  subdomain         String
  client_id         String
  /// All secrets go through services/encryption.ts (enc:v1: prefix), never plaintext.
  client_secret_enc String
  access_token_enc  String?
  refresh_token_enc String?
  redirect_uri      String
  token_expires_at  DateTime?
  status            AmoIntegrationStatus @default(active)
  /// Set when a refresh comes back invalid_grant. The queue stops rather than retrying: that
  /// error is terminal until a human re-authorizes, and hammering it earns a ban.
  needs_reauth_at   DateTime?
  last_sync_at      DateTime?
  last_error        String?
  /// amoCRM webhook subscription ids, so they can be torn down on disconnect.
  webhook_ids       String[]
  connected_by      String?              @db.Uuid
  created_at        DateTime             @default(now())
  updated_at        DateTime             @updatedAt

  organization Org   @relation(fields: [organization_id], references: [id])
  connector    User? @relation("AmoIntegrationConnectedBy", fields: [connected_by], references: [id])
}

/// The identity bridge between a 4КУБ row and its amoCRM counterpart.
///
/// Without this, every inbound webhook re-creates what the import already pulled. The two hash
/// columns are what stops the echo loop: an outbound payload whose hash equals last_remote_hash
/// is a change we ourselves just received, and is dropped instead of sent back.
model AmoEntityMap {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id  String    @db.Uuid
  /// 'contact' | 'company' | 'lead'
  entity_type      String
  local_id         String    @db.Uuid
  amo_id           BigInt
  last_synced_at   DateTime?
  last_local_hash  String?
  last_remote_hash String?
  created_at       DateTime  @default(now())
  updated_at       DateTime  @updatedAt

  organization Org @relation(fields: [organization_id], references: [id])

  @@unique([organization_id, entity_type, amo_id])
  @@unique([organization_id, entity_type, local_id])
  @@index([organization_id, entity_type])
}

/// Work queue for both directions of the sync, shaped after WebhookDelivery.
///
/// Inbound rows are written by the webhook receiver, which must answer amoCRM fast — amoCRM
/// retries any non-2xx and disables a subscription that keeps failing, so the HTTP handler
/// verifies the signature, enqueues, and returns. Outbound rows are written by the domain layer
/// when a local change needs pushing.
model AmoSyncJob {
  id              String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id String           @db.Uuid
  direction       AmoSyncDirection
  entity_type     String
  local_id        String?          @db.Uuid
  amo_id          BigInt?
  /// 'create' | 'update' | 'delete' | 'stage_change'
  operation       String
  payload         Json
  status          AmoSyncJobStatus @default(pending)
  attempts        Int              @default(0)
  next_attempt_at DateTime?
  error_message   String?
  processed_at    DateTime?
  created_at      DateTime         @default(now())
  updated_at      DateTime         @updatedAt

  organization Org @relation(fields: [organization_id], references: [id])

  @@index([status, next_attempt_at])
  @@index([organization_id, direction, status])
  @@index([organization_id, entity_type, local_id])
}

/// Every time last-write-wins threw something away, it is written down here.
///
/// A silent clobber is indistinguishable from data loss to the person whose edit vanished.
/// This is the record that lets someone answer "where did my change go" afterwards.
model AmoSyncConflict {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id   String    @db.Uuid
  entity_type       String
  local_id          String?   @db.Uuid
  amo_id            BigInt?
  field             String
  local_value       String?
  remote_value      String?
  /// 'local' | 'remote'
  winner            String
  local_updated_at  DateTime?
  remote_updated_at DateTime?
  created_at        DateTime  @default(now())

  organization Org @relation(fields: [organization_id], references: [id])

  @@index([organization_id, created_at])
}

enum LeadInboxStatus {
  active
  paused
  error
}

enum LeadInboxMode {
  /// Заявки arrive at a per-org address of the PLATFORM's single collector
  /// mailbox (LEAD_COLLECTOR_* env) — the org holds no mail credentials at
  /// all, only `intake_token`, and its whole setup is pasting the address
  /// into Яндекс Бизнес.
  collector
  /// The org's own IMAP mailbox — the advanced/self-hosted path.
  custom
}

/// A mailbox polled for inbound lead-request notifications — today that means
/// Яндекс Бизнес «Заявки»: the form on an organization's Maps profile can only
/// exit through SMS, Telegram or EMAIL notifications (no API, no webhook), so a
/// dedicated mailbox receives the notification and the scheduler turns it into
/// a contact + deal in this org's funnel.
///
/// One inbox per organization, mirroring AmoIntegration. The password goes
/// through services/encryption.ts (enc:v1: prefix), never plaintext — for
/// Yandex Mail it is an app password («пароль приложения»), which the owner can
/// revoke without changing the account password.
model LeadInbox {
  id                String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id   String          @unique @db.Uuid
  mode              LeadInboxMode   @default(collector)
  /// The org's slice of the collector mailbox: its address is the pattern env
  /// with this token substituted (e.g. login+TOKEN@yandex.ru). Stable once
  /// minted — the address is pasted into external cabinets and must not rot.
  intake_token      String?         @unique
  imap_host         String          @default("imap.yandex.ru")
  imap_port         Int             @default(993)
  /// Null in collector mode — the org holds no mail credentials there.
  imap_user         String?
  imap_password_enc String?
  /// Target funnel. Left null, the org's default pipeline and its first open
  /// stage are resolved at processing time — so archiving a stage can never
  /// strand the inbox, it just falls back.
  pipeline_id       String?         @db.Uuid
  stage_id          String?         @db.Uuid
  /// Every created contact/deal is assigned here. This is also what makes the
  /// phone buzz: deal-domain fires `deal.assigned` for any assigned deal.
  assigned_to       String?         @db.Uuid
  source_label      String          @default("Яндекс Карты")
  status            LeadInboxStatus @default(active)
  last_polled_at    DateTime?
  last_error        String?
  created_by        String?         @db.Uuid
  created_at        DateTime        @default(now())
  updated_at        DateTime        @updatedAt

  organization Org                @relation(fields: [organization_id], references: [id])
  creator      User?              @relation("LeadInboxCreatedBy", fields: [created_by], references: [id])
  messages     LeadInboxMessage[]
}

/// One row per email the poller has CLAIMED, unique on (inbox, uidvalidity, uid).
///
/// The claim is taken with createMany+skipDuplicates BEFORE anything is created
/// from the message, so a crash between "deal created" and "\Seen flag set"
/// cannot turn one заявка into two deals on the next tick. IMAP UIDs are only
/// stable within one UIDVALIDITY epoch, which is why the epoch is part of the
/// key; Message-ID catches the same email re-appearing across epochs.
model LeadInboxMessage {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  inbox_id        String    @db.Uuid
  organization_id String    @db.Uuid
  uid_validity    BigInt
  message_uid     Int
  message_id      String?
  from_addr       String?
  subject         String?
  contact_id      String?   @db.Uuid
  deal_id         String?   @db.Uuid
  /// 'claimed' | 'processed' | 'failed' | 'duplicate'
  status          String    @default("claimed")
  error           String?
  received_at     DateTime?
  created_at      DateTime  @default(now())

  inbox        LeadInbox @relation(fields: [inbox_id], references: [id], onDelete: Cascade)
  organization Org       @relation(fields: [organization_id], references: [id])

  @@unique([inbox_id, uid_validity, message_uid])
  @@index([organization_id, created_at])
}

/// Durable rate-limit counters for the UNAUTHENTICATED auth routes only.
///
/// Deliberately NOT used by the global limiter in backend/index.ts, nor by the
/// high-volume route limiters (tracking pixel, OTA manifest and assets, amoCRM
/// webhook, imports, export) — one INSERT per request there would be real write
/// amplification on the same disk as the customer data, and none of them guards a
/// secret worth counting durably. See services/rate-limit-store.ts.
///
/// No organization_id, and that is deliberate: every row here is written BEFORE
/// authentication, so there is no tenant to scope to. Same exception, and the same
/// reason, as the IdempotencyKey TTL sweep — server-side housekeeping, never a
/// tenant read.
///
/// `id` is a SHA-256 digest of "<scope>|<key>", never the key itself. The key on
/// POST /auth/login is the IP joined to the submitted email and LoginSchema caps
/// neither, so storing it raw would be both a table-bloat vector on an
/// unauthenticated endpoint and a new register of who tried to sign in from where
/// (ФЗ-152).
model RateLimitBucket {
  id           String   @id
  count        Int      @default(0)
  window_start DateTime
  expires_at   DateTime
  updated_at   DateTime @updatedAt

  @@index([expires_at])
}
