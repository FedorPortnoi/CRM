// Prisma schema for Mobile CRM Platform
// Prisma 5.13.0 | Yandex Managed PostgreSQL (ru-central1)

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum UserRole {
  owner
  admin
  member
  viewer
}

enum OrgPlan {
  starter
  growth
  business
}

enum ContactType {
  lead
  customer
  partner
  other
}

enum ContactStatus {
  active
  inactive
  archived
}

enum DealStatus {
  open
  won
  lost
  archived
}

enum TaskPriority {
  low
  medium
  high
  urgent
}

enum TaskStatus {
  pending
  in_progress
  done
  cancelled
}

enum MessageDirection {
  inbound
  outbound
}

enum MessageChannel {
  in_app
  email
  call
}

enum MessageStatus {
  pending
  sent
  delivered
  read
  failed
}

enum CalendarEventStatus {
  scheduled
  completed
  cancelled
}

enum WorkflowStatus {
  active
  paused
  archived
}

enum WorkflowTrigger {
  contact_created
  deal_stage_changed
  task_completed
  deal_won
  deal_created
  task_created
  deal_stale
}

enum WorkflowRunStatus {
  success
  failed
}

enum PendingCaptureType {
  call
  email
}

enum PendingCaptureStatus {
  pending
  matched
  dismissed
}

enum WebhookStatus {
  active
  paused
}

enum WebhookDeliveryStatus {
  pending
  success
  failed
}

enum SequenceStatus {
  draft
  active
  paused
  archived
}

enum SequenceEnrollmentStatus {
  active
  completed
  unsubscribed
  failed
  cancelled
}

enum EmailSendStatus {
  queued
  sent
  failed
  opened
}

enum AssistantMessageRole {
  user
  assistant
  tool
}

// ---------------------------------------------------------------------------
// Models
// ---------------------------------------------------------------------------

model User {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id   String    @db.Uuid
  email             String?   @unique @db.Citext
  username          String?   @db.Citext
  password_hash     String
  name              String
  role              UserRole  @default(member)
  avatar_url        String?
  phone             String?
  is_active              Boolean   @default(true)
  onboarding_state       Json?
  preferences            Json?
  last_seen_at           DateTime?
  invited_by             String?   @db.Uuid
  manager_id             String?   @db.Uuid
  created_at             DateTime  @default(now())
  updated_at             DateTime  @updatedAt
  push_token             String?
  failed_login_count     Int       @default(0)
  locked_until           DateTime?
  is_verified            Boolean   @default(false)
  phone_verified         Boolean   @default(false)
  email_verified         Boolean   @default(false)
  must_change_password   Boolean   @default(false)
  must_change_email      Boolean   @default(false)

  // Relations
  organization     Org       @relation("UserOrg", fields: [organization_id], references: [id])
  inviter          User?     @relation("UserInviter", fields: [invited_by], references: [id])
  invitees         User[]    @relation("UserInviter")
  manager          User?     @relation("UserManager", fields: [manager_id], references: [id])
  reports          User[]    @relation("UserManager")
  ownedOrgs        Org[]     @relation("OrgOwner")
  assignedContacts Contact[] @relation("ContactAssignedTo")
  createdContacts  Contact[] @relation("ContactCreatedBy")
  assignedDeals    Deal[]    @relation("DealAssignedTo")
  createdDeals     Deal[]    @relation("DealCreatedBy")
  assignedTasks    Task[]    @relation("TaskAssignedTo")
  createdTasks     Task[]    @relation("TaskCreatedBy")
  completedTasks        Task[]              @relation("TaskCompletedBy")
  messages              Message[]
  calendarEventsCreated CalendarEvent[]     @relation("CalendarEventCreatedBy")
  calendarSyncs         UserCalendarSync[]
  createdPipelines      Pipeline[]          @relation("PipelineCreatedBy")
  createdWorkflows      Workflow[]          @relation("WorkflowCreatedBy")
  authSessions          AuthSession[]
  auditEvents           AuditEvent[]
  activityLogs          ActivityLog[] @relation("ActivityLogUser")
  uploadedAttachments   Attachment[]  @relation("AttachmentUploader")
  verificationCodes     VerificationCode[]
  chatMessages          ChatMessage[]      @relation("ChatMessageSender")
  chatReadReceipts      ChatReadReceipt[]  @relation("ChatReadReceiptUser")
  notifications         Notification[]     @relation("NotificationRecipient")
  createdApiKeys        ApiKey[]           @relation("ApiKeyCreatedBy")
  createdWebhookEndpoints WebhookEndpoint[] @relation("WebhookEndpointCreatedBy")
  createdEmailTemplates   EmailTemplate[]        @relation("EmailTemplateCreatedBy")
  createdSequences        Sequence[]             @relation("SequenceCreatedBy")
  sequenceEnrollments     SequenceEnrollment[]   @relation("SequenceEnrollmentEnrolledBy")
  assistantConversations  AssistantConversation[] @relation("AssistantConversationUser")

  // Employees log in by username, which only needs to be unique inside their org.
  @@unique([organization_id, username])
  @@index([manager_id])
}

model Org {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name          String
  slug          String   @unique
  plan          OrgPlan  @default(starter)
  owner_id      String?  @db.Uuid
  settings      Json?
  plan_features           Json?
  stalled_threshold_days  Int     @default(30)
  decay_factor            Float   @default(0.5)
  join_code               String?   @unique
  join_code_expires_at    DateTime?
  created_at              DateTime @default(now())
  updated_at              DateTime @updatedAt

  // Relations
  owner    User?     @relation("OrgOwner", fields: [owner_id], references: [id])
  users    User[]    @relation("UserOrg")
  contacts Contact[]
  deals    Deal[]
  tasks          Task[]
  messages       Message[]
  calendarEvents CalendarEvent[]
  pipelines       Pipeline[]
  workflows       Workflow[]
  pendingCaptures PendingCapture[]
  authSessions    AuthSession[]
  auditEvents     AuditEvent[]
  activityLogs    ActivityLog[]
  attachments     Attachment[]
  chatMessages    ChatMessage[]  @relation("ChatMessageOrg")
  notifications   Notification[] @relation("NotificationOrg")
  apiKeys          ApiKey[]
  webhookEndpoints WebhookEndpoint[]
  webhookDeliveries WebhookDelivery[]
  idempotencyKeys  IdempotencyKey[]
  emailTemplates         EmailTemplate[]
  sequences              Sequence[]
  sequenceSteps          SequenceStep[]
  sequenceEnrollments    SequenceEnrollment[]
  emailSends             EmailSend[]
  assistantConversations AssistantConversation[]
  assistantMessages      AssistantMessage[]

  @@map("organizations")
}

model AuthSession {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id String    @db.Uuid
  user_id         String    @db.Uuid
  token_hash      String    @unique
  user_agent      String?
  ip_address      String?
  revoked_at      DateTime?
  revoked_reason  String?
  last_seen_at    DateTime?
  expires_at      DateTime?
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt

  organization Org  @relation(fields: [organization_id], references: [id])
  user         User @relation(fields: [user_id], references: [id])

  @@index([user_id, revoked_at])
  @@index([organization_id, created_at])
}

model AuditEvent {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id String?  @db.Uuid
  user_id         String?  @db.Uuid
  action          String
  outcome         String   @default("success")
  target_type     String?
  target_id       String?
  ip_address      String?
  user_agent      String?
  metadata        Json?
  created_at      DateTime @default(now())

  organization Org?  @relation(fields: [organization_id], references: [id])
  user         User? @relation(fields: [user_id], references: [id])

  @@index([organization_id, created_at])
  @@index([user_id, created_at])
  @@index([action, created_at])
}

model Contact {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id String        @db.Uuid
  first_name      String
  last_name       String?
  company         String?
  email           String?
  /// HMAC-SHA256 hex of the normalized email — lets encrypted PII stay searchable
  email_bidx      String?       @db.Text
  phone           String?
  /// HMAC-SHA256 hex of the normalized phone — lets encrypted PII stay searchable
  phone_bidx      String?       @db.Text
  mobile          String?
  /// HMAC-SHA256 hex of the normalized mobile — lets encrypted PII stay searchable
  mobile_bidx     String?       @db.Text
  address         Json?
  /// Stored as a JSON array (mirrors PostgreSQL text[] column)
  tags            Json?
  source          String?
  notes           String?
  avatar_url      String?
  assigned_to     String?       @db.Uuid
  type            ContactType   @default(lead)
  status          ContactStatus @default(active)
  custom_fields   Json?
  is_example_data Boolean       @default(false)
  /// ФЗ-38 «О рекламе» ст. 18 — advertising mailings require PRIOR consent and fines
  /// are per message, so these five columns ARE the legal evidence. Never send unless
  /// marketing_consent = true AND unsubscribed_at IS NULL.
  marketing_consent        Boolean   @default(false)
  marketing_consent_at     DateTime?
  /// How consent was obtained: form, import, verbal, contract, ...
  marketing_consent_source String?
  unsubscribed_at          DateTime?
  /// Unguessable token for one-click unsubscribe links (no auth required)
  unsubscribe_token        String?   @unique
  created_by      String?       @db.Uuid
  created_at      DateTime      @default(now())
  updated_at      DateTime      @updatedAt

  // Relations
  organization Org      @relation(fields: [organization_id], references: [id])
  assignee     User?    @relation("ContactAssignedTo", fields: [assigned_to], references: [id])
  creator      User?    @relation("ContactCreatedBy", fields: [created_by], references: [id])
  deals           Deal[]
  tasks           Task[]
  messages        Message[]
  calendarEvents  CalendarEvent[]
  pendingCaptures PendingCapture[]
  sequenceEnrollments SequenceEnrollment[]
  emailSends          EmailSend[]

  @@index([organization_id, status])
  @@index([organization_id, created_at])
  @@index([organization_id, email_bidx])
  @@index([organization_id, phone_bidx])
  @@index([organization_id, mobile_bidx])
  @@index([email_bidx])
  @@index([phone_bidx])
  @@index([mobile_bidx])
  // The sequence sender filters on exactly this triple before queueing a message.
  @@index([organization_id, marketing_consent, unsubscribed_at])
}

model Deal {
  id              String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id String     @db.Uuid
  title           String
  contact_id      String?    @db.Uuid
  pipeline_id     String?    @db.Uuid
  stage_id        String?    @db.Uuid
  value           Decimal?
  currency        String?    @default("RUB")
  expected_close  DateTime?
  actual_close    DateTime?
  probability     Int?
  status          DealStatus @default(open)
  lost_reason     String?
  next_action      String?
  next_action_due  DateTime?
  stage_entered_at DateTime   @default(now())
  source          String?
  assigned_to     String?    @db.Uuid
  custom_fields   Json?
  is_example_data Boolean    @default(false)
  created_by      String?    @db.Uuid
  created_at      DateTime   @default(now())
  updated_at      DateTime   @updatedAt

  // Relations
  organization Org      @relation(fields: [organization_id], references: [id])
  contact      Contact? @relation(fields: [contact_id], references: [id])
  assignee       User?           @relation("DealAssignedTo", fields: [assigned_to], references: [id])
  creator        User?           @relation("DealCreatedBy", fields: [created_by], references: [id])
  pipeline       Pipeline?       @relation(fields: [pipeline_id], references: [id])
  stage          PipelineStage?  @relation(fields: [stage_id], references: [id])
  tasks          Task[]
  calendarEvents CalendarEvent[]

  @@index([organization_id, status])
  @@index([organization_id, created_at])
  @@index([organization_id, contact_id])
  @@index([organization_id, pipeline_id])
}

model Task {
  id              String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id String       @db.Uuid
  title           String
  description     String?
  contact_id      String?      @db.Uuid
  deal_id         String?      @db.Uuid
  assigned_to     String       @db.Uuid
  created_by      String?      @db.Uuid
  due_date        DateTime?
  priority        TaskPriority @default(medium)
  status          TaskStatus   @default(pending)
  is_recurring    Boolean      @default(false)
  recurrence_rule String?
  reminder_at     DateTime?
  completed_at    DateTime?
  completed_by    String?      @db.Uuid
  is_example_data Boolean      @default(false)
  created_at      DateTime     @default(now())
  updated_at      DateTime     @updatedAt

  // Relations
  organization Org      @relation(fields: [organization_id], references: [id])
  contact      Contact? @relation(fields: [contact_id], references: [id])
  deal         Deal?    @relation(fields: [deal_id], references: [id])
  assignee     User     @relation("TaskAssignedTo", fields: [assigned_to], references: [id])
  creator      User?    @relation("TaskCreatedBy", fields: [created_by], references: [id])
  completer    User?    @relation("TaskCompletedBy", fields: [completed_by], references: [id])

  @@index([organization_id, status, due_date])
  @@index([organization_id, created_at])
  @@index([organization_id, contact_id])
  @@index([organization_id, deal_id])
}

model Message {
  id              String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id String           @db.Uuid
  contact_id      String           @db.Uuid
  user_id         String?          @db.Uuid
  direction       MessageDirection
  channel         MessageChannel
  body            String
  status          MessageStatus    @default(pending)
  error_message   String?
  twilio_sid      String?
  read_at         DateTime?
  delivered_at    DateTime?
  created_at      DateTime         @default(now())

  // Relations
  organization Org      @relation(fields: [organization_id], references: [id])
  contact      Contact  @relation(fields: [contact_id], references: [id])
  user         User?    @relation(fields: [user_id], references: [id])

  @@index([organization_id, created_at])
  @@index([organization_id, contact_id, created_at])
}

model CalendarEvent {
  id                    String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id       String              @db.Uuid
  title                 String
  description           String?
  contact_id            String?             @db.Uuid
  deal_id               String?             @db.Uuid
  created_by            String?             @db.Uuid
  attendee_ids          Json?
  start_time            DateTime
  end_time              DateTime
  location              String?
  meeting_url           String?
  reminder_minutes      Int                 @default(30)
  status                CalendarEventStatus @default(scheduled)
  notes                 String?
  completed_at          DateTime?
  post_meeting_prompted Boolean             @default(false)
  ext_event_uid         String?
  ext_calendar_uid      String?
  is_example_data       Boolean             @default(false)
  created_at            DateTime            @default(now())
  updated_at            DateTime            @updatedAt

  // Relations
  organization Org      @relation(fields: [organization_id], references: [id])
  contact      Contact? @relation(fields: [contact_id], references: [id])
  deal         Deal?    @relation(fields: [deal_id], references: [id])
  creator      User?    @relation("CalendarEventCreatedBy", fields: [created_by], references: [id])

  @@index([organization_id, status, start_time])
  @@index([organization_id, created_at])
  @@index([organization_id, contact_id])
  @@index([organization_id, deal_id])
}

model UserCalendarSync {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id             String    @db.Uuid
  provider            String
  access_token        String
  refresh_token       String?
  expires_at          DateTime?
  ext_calendar_uid    String?
  yandex_username     String?
  yandex_calendar_slug String?
  created_at          DateTime  @default(now())
  updated_at          DateTime  @updatedAt

  // Relations
  user User @relation(fields: [user_id], references: [id])

  @@unique([user_id, provider])
}

model Pipeline {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id String   @db.Uuid
  name            String
  description     String?
  is_default      Boolean  @default(false)
  created_by      String?  @db.Uuid
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  // Relations
  organization Org             @relation(fields: [organization_id], references: [id])
  creator      User?           @relation("PipelineCreatedBy", fields: [created_by], references: [id])
  stages       PipelineStage[]
  deals        Deal[]
}

model PipelineStage {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  pipeline_id   String   @db.Uuid
  name          String
  position      Int
  color         String?
  is_won_stage  Boolean  @default(false)
  is_lost_stage Boolean  @default(false)
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  // Relations
  pipeline Pipeline @relation(fields: [pipeline_id], references: [id])
  deals    Deal[]
}

model Workflow {
  id              String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id String          @db.Uuid
  name            String
  description     String?
  trigger         WorkflowTrigger
  conditions      Json?
  actions         Json
  status          WorkflowStatus  @default(active)
  created_by      String?         @db.Uuid
  created_at      DateTime        @default(now())
  updated_at      DateTime        @updatedAt

  organization Org           @relation(fields: [organization_id], references: [id])
  creator      User?         @relation("WorkflowCreatedBy", fields: [created_by], references: [id])
  runs         WorkflowRun[]

  @@index([organization_id, status, trigger])
}

model WorkflowRun {
  id                String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workflow_id       String            @db.Uuid
  organization_id   String            @db.Uuid
  trigger_record_id String?
  status            WorkflowRunStatus
  error_message     String?
  created_at        DateTime          @default(now())

  workflow Workflow @relation(fields: [workflow_id], references: [id])

  @@index([organization_id, created_at])
  @@index([workflow_id, created_at])
}

model PendingCapture {
  id           String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  org_id       String                @db.Uuid
  type         PendingCaptureType
  raw_data     Json
  phone_number String?
  status       PendingCaptureStatus  @default(pending)
  contact_id   String?               @db.Uuid
  created_at   DateTime              @default(now())

  org     Org      @relation(fields: [org_id], references: [id])
  contact Contact? @relation(fields: [contact_id], references: [id])

  @@index([org_id, status])
  @@index([org_id, created_at])
}

model ActivityLog {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id String   @db.Uuid
  user_id         String?  @db.Uuid
  entity_type     String
  entity_id       String   @db.Uuid
  action          String
  changes         Json?
  created_at      DateTime @default(now())
  organization Org   @relation(fields: [organization_id], references: [id])
  user         User? @relation("ActivityLogUser", fields: [user_id], references: [id])
  @@index([organization_id, entity_type, entity_id])
  @@index([organization_id, created_at])
}
model Attachment {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id String   @db.Uuid
  entity_type     String
  entity_id       String   @db.Uuid
  filename        String
  file_url        String
  size            Int?
  mime_type       String?
  uploaded_by     String?  @db.Uuid
  created_at      DateTime @default(now())
  organization Org   @relation(fields: [organization_id], references: [id])
  uploader     User? @relation("AttachmentUploader", fields: [uploaded_by], references: [id])
  @@index([organization_id, entity_type, entity_id])
}

model VerificationCode {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String    @db.Uuid
  code_hash  String
  channel    String
  expires_at DateTime
  used_at    DateTime?
  created_at DateTime  @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, channel])
}
model ChatMessage {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id String   @db.Uuid
  sender_id       String   @db.Uuid
  channel         String
  body            String
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  organization Org  @relation("ChatMessageOrg", fields: [organization_id], references: [id])
  sender       User @relation("ChatMessageSender", fields: [sender_id], references: [id])

  @@index([organization_id, channel, created_at(sort: Desc)])
}

model ChatReadReceipt {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id String   @db.Uuid
  user_id         String   @db.Uuid
  channel         String
  last_read_at    DateTime @default(now())
  updated_at      DateTime @updatedAt

  user User @relation("ChatReadReceiptUser", fields: [user_id], references: [id])

  @@unique([user_id, channel])
  @@index([organization_id, user_id])
}

model Notification {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id String    @db.Uuid
  recipient_id    String    @db.Uuid
  event_type      String
  role            String
  title           String
  body            String
  entity_type     String
  entity_id       String    @db.Uuid
  data            Json?
  is_read         Boolean   @default(false)
  read_at         DateTime?
  created_at      DateTime  @default(now())

  organization Org  @relation("NotificationOrg", fields: [organization_id], references: [id])
  recipient    User @relation("NotificationRecipient", fields: [recipient_id], references: [id])

  @@index([recipient_id, is_read, created_at(sort: Desc)])
  @@index([organization_id, created_at])
}

model NotificationSent {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  event_type   String
  entity_id    String   @db.Uuid
  recipient_id String   @db.Uuid
  created_at   DateTime @default(now())

  @@unique([event_type, entity_id, recipient_id])
  @@index([created_at])
}

model ApiKey {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id String    @db.Uuid
  name            String
  key_prefix      String
  key_hash        String    @unique
  /// Stored as a JSON array of scope strings (mirrors PostgreSQL text[] usage elsewhere)
  scopes          Json?
  created_by      String?   @db.Uuid
  last_used_at    DateTime?
  revoked_at      DateTime?
  expires_at      DateTime?
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt

  organization Org   @relation(fields: [organization_id], references: [id])
  creator      User? @relation("ApiKeyCreatedBy", fields: [created_by], references: [id])

  @@index([organization_id, revoked_at])
  @@index([organization_id, created_at])
  @@index([key_prefix])
}

model WebhookEndpoint {
  id               String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id  String        @db.Uuid
  url              String
  secret           String
  /// Stored as a JSON array of subscribed event types
  events           Json
  status           WebhookStatus @default(active)
  created_by       String?       @db.Uuid
  last_delivery_at DateTime?
  failure_count    Int           @default(0)
  created_at       DateTime      @default(now())
  updated_at       DateTime      @updatedAt

  organization Org               @relation(fields: [organization_id], references: [id])
  creator      User?             @relation("WebhookEndpointCreatedBy", fields: [created_by], references: [id])
  deliveries   WebhookDelivery[]

  @@index([organization_id, status])
  @@index([organization_id, created_at])
}

model WebhookDelivery {
  id              String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id String                @db.Uuid
  endpoint_id     String                @db.Uuid
  event_type      String
  payload         Json
  status          WebhookDeliveryStatus @default(pending)
  response_status Int?
  attempts        Int                   @default(0)
  error_message   String?
  next_attempt_at DateTime?
  delivered_at    DateTime?
  created_at      DateTime              @default(now())
  updated_at      DateTime              @updatedAt

  organization Org             @relation(fields: [organization_id], references: [id])
  endpoint     WebhookEndpoint @relation(fields: [endpoint_id], references: [id])

  @@index([organization_id, status, created_at])
  @@index([organization_id, endpoint_id, created_at(sort: Desc)])
  @@index([status, next_attempt_at])
}

model IdempotencyKey {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id String   @db.Uuid
  key             String
  endpoint        String
  request_hash    String
  response_body   Json?
  status_code     Int?
  created_at      DateTime @default(now())
  expires_at      DateTime

  organization Org @relation(fields: [organization_id], references: [id])

  @@unique([organization_id, key])
  @@index([expires_at])
}

// ---------------------------------------------------------------------------
// Email sequences (wave 2)
// ---------------------------------------------------------------------------

model EmailTemplate {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id String   @db.Uuid
  name            String
  subject         String
  /// Plain-text body; supports {{placeholders}} rendered at send time
  body            String
  created_by      String?  @db.Uuid
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  organization Org            @relation(fields: [organization_id], references: [id])
  creator      User?          @relation("EmailTemplateCreatedBy", fields: [created_by], references: [id])
  steps        SequenceStep[]
  sends        EmailSend[]

  @@index([organization_id, created_at])
  @@index([organization_id, name])
}

model Sequence {
  id              String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id String         @db.Uuid
  name            String
  description     String?
  status          SequenceStatus @default(draft)
  created_by      String?        @db.Uuid
  created_at      DateTime       @default(now())
  updated_at      DateTime       @updatedAt

  organization Org                  @relation(fields: [organization_id], references: [id])
  creator      User?                @relation("SequenceCreatedBy", fields: [created_by], references: [id])
  steps        SequenceStep[]
  enrollments  SequenceEnrollment[]

  @@index([organization_id, status])
  @@index([organization_id, created_at])
}

model SequenceStep {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sequence_id     String   @db.Uuid
  organization_id String   @db.Uuid
  /// 0-based ordering inside the sequence
  position        Int
  /// Days to wait after the previous step (0 = send as soon as the step is due)
  delay_days      Int      @default(0)
  /// Either template_id OR the inline subject/body pair supplies the content
  template_id     String?  @db.Uuid
  subject         String?
  body            String?
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  organization Org            @relation(fields: [organization_id], references: [id])
  sequence     Sequence       @relation(fields: [sequence_id], references: [id])
  template     EmailTemplate? @relation(fields: [template_id], references: [id])
  sends        EmailSend[]

  @@index([sequence_id, position])
  @@index([organization_id, sequence_id])
}

model SequenceEnrollment {
  id              String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sequence_id     String                   @db.Uuid
  contact_id      String                   @db.Uuid
  organization_id String                   @db.Uuid
  status          SequenceEnrollmentStatus @default(active)
  /// Index of the next step to send (0-based, matches SequenceStep.position)
  current_step    Int                      @default(0)
  next_send_at    DateTime?
  enrolled_by     String?                  @db.Uuid
  enrolled_at     DateTime                 @default(now())
  completed_at    DateTime?
  updated_at      DateTime                 @updatedAt

  organization Org         @relation(fields: [organization_id], references: [id])
  sequence     Sequence    @relation(fields: [sequence_id], references: [id])
  contact      Contact     @relation(fields: [contact_id], references: [id])
  enroller     User?       @relation("SequenceEnrollmentEnrolledBy", fields: [enrolled_by], references: [id])
  sends        EmailSend[]

  // A contact cannot be double-enrolled in the same sequence.
  @@unique([sequence_id, contact_id])
  // The scheduler polls on exactly this triple.
  @@index([organization_id, status, next_send_at])
  @@index([organization_id, contact_id])
  @@index([sequence_id, status])
}

model EmailSend {
  id                  String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id     String          @db.Uuid
  enrollment_id       String?         @db.Uuid
  step_id             String?         @db.Uuid
  contact_id          String          @db.Uuid
  template_id         String?         @db.Uuid
  subject             String
  status              EmailSendStatus @default(queued)
  provider_message_id String?
  error_message       String?
  sent_at             DateTime?
  opened_at           DateTime?
  /// Unguessable token embedded in the tracking-pixel URL
  open_token          String          @unique
  created_at          DateTime        @default(now())
  updated_at          DateTime        @updatedAt

  organization Org                 @relation(fields: [organization_id], references: [id])
  enrollment   SequenceEnrollment? @relation(fields: [enrollment_id], references: [id])
  step         SequenceStep?       @relation(fields: [step_id], references: [id])
  contact      Contact             @relation(fields: [contact_id], references: [id])
  template     EmailTemplate?      @relation(fields: [template_id], references: [id])

  @@index([organization_id, status, created_at])
  @@index([organization_id, contact_id, created_at])
  @@index([enrollment_id, created_at])
}

// ---------------------------------------------------------------------------
// AI assistant (wave 2)
// ---------------------------------------------------------------------------

model AssistantConversation {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id String   @db.Uuid
  user_id         String   @db.Uuid
  title           String?
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  organization Org                @relation(fields: [organization_id], references: [id])
  user         User               @relation("AssistantConversationUser", fields: [user_id], references: [id])
  messages     AssistantMessage[]

  @@index([organization_id, user_id, updated_at(sort: Desc)])
  @@index([organization_id, created_at])
}

model AssistantMessage {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // Intra-turn ordering. Every message of one assistant turn is written inside a
  // single transaction, so created_at is the SAME CURRENT_TIMESTAMP on all of
  // them and the random-UUID primary key is no tiebreaker. seq is BIGSERIAL:
  // nextval() is claimed per INSERT, so it records true insertion order and is
  // the only column replay may order by. Never select it into an API response —
  // Prisma maps BigInt to a JS bigint, which JSON.stringify refuses.
  seq             BigInt               @default(autoincrement())
  organization_id String               @db.Uuid
  conversation_id String               @db.Uuid
  role            AssistantMessageRole
  content         String
  tool_calls      Json?
  created_at      DateTime             @default(now())

  organization Org                   @relation(fields: [organization_id], references: [id])
  conversation AssistantConversation @relation(fields: [conversation_id], references: [id], onDelete: Cascade)

  @@index([conversation_id, seq])
  @@index([organization_id, created_at])
}
