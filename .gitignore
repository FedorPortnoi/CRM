# @generated expo-cli sync-2b81b286409207a5da26e14c78851eb30d8ccbdb
# The following patterns were generated by expo-cli

expo-env.d.ts
# @end expo-cli

# Secrets and local build artifacts — never commit
/certs/
/android/
/releases/
.auth-state.json

# Backup copies of an env file hold exactly the same live credentials as the
# original, so they get the same treatment as .env above.
.env.bak*
.env.*.bak
*.env.backup

# wrangler's local secrets file (workers/*). The worker directory ships its own
# .gitignore saying this; repeated here so deleting that file cannot expose it.
.dev.vars
.dev.vars.*
!.dev.vars.example

# Claude Code local scratch / worktrees (~85MB, never commit)
.claude/

# Signing and publishing credentials. Named individually below for history, but
# these globs are what actually stop the next one: eas.json points Android
# submit at ./google-play-service-account.json, a path nothing covered until
# this line — so creating that file to make submission work would have pushed a
# Play publishing key to a PUBLIC repo.
*service-account*.json
*.p8
*.jks
*.keystore
credentials.json
id_rsa*
*.key
backend-log.txt

# Local self-hosted production env. Holds the real JWT secret, the field
# encryption key and the database password — the same secrets as the server's
# .env. Ignored in BOTH files, because .easignore replaces .gitignore for EAS
# uploads rather than stacking on it.
.env.localprod
.env.local-prod

# The OTA code-signing CERTIFICATE is public and must be committed.
#
# expo-updates reads it at prebuild time and bakes it into the binary, so EAS has to
# receive it — and EAS uploads via git, which means .easignore cannot re-admit what
# .gitignore excluded. It is the public half: the app uses it to verify that an update
# manifest was signed by us. Publishing it gives an attacker nothing.
#
# The PRIVATE key on the line below stays excluded and must never be committed — it is
# what signs a manifest, so anyone holding it can push arbitrary code to every install.
!certs/updates/certificate.pem
dist.*-rollback/

# Scratch outputs, not app source — kept on disk, not shipped in the public repo.
# tools/splash-remotion: Remotion project + a dozen draft .mp4 iterations used to
# produce assets/splash-intro.mp4; the final render is committed, the drafts aren't.
# website/4kub.ru-audit: raw SEO-audit tool output (page dumps, screenshots, JSON) —
# analysis artifacts, not something the site serves.
tools/splash-remotion/
website/4kub.ru-audit/
