{
  "compilerOptions": {
    "target": "es2022",
    "module": "es2022",
    "moduleResolution": "bundler",
    "lib": ["es2022"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "noUncheckedIndexedAccess": false
  },
  // Workers runtime globals come from worker-configuration.d.ts, regenerated by
  // `wrangler types` (wired into `npm run typecheck`). The tests are excluded:
  // they run on Node, whose globals conflict with the Workers ones, and they
  // are verified by actually executing rather than by tsc.
  "include": ["src/**/*.ts", "worker-configuration.d.ts"]
}
