# The repository root .gitignore covers .env but knows nothing about wrangler's
# .dev.vars, which holds exactly the same class of secret. Keep this file.
.dev.vars
.dev.vars.*
!.dev.vars.example

node_modules/
.wrangler/

# Generated by `wrangler types` (run by `npm run typecheck`). 500KB+ of Workers
# runtime declarations — regenerate it, don't commit it.
worker-configuration.d.ts
dist/
*.log
