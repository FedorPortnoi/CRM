{
  "expo": {
    "name": "4KUB",
    "slug": "crm",
    "version": "1.1.8",
    "owner": "flada",
    "scheme": "crm",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "updates": {
      "enabled": true,
      "url": "https://4kub.ru/api/v1/updates/manifest",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 15000,
      "codeSigningCertificate": "./certs/updates/certificate.pem",
      "codeSigningMetadata": {
        "keyid": "main",
        "alg": "rsa-v1_5-sha256"
      }
    },
    "runtimeVersion": "1.1.8-native2",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A0A0A"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.fedorportnoi.crm",
      "buildNumber": "40",
      "infoPlist": {
        "CFBundleDisplayName": "4КУБ",
        "NSLocationWhenInUseUsageDescription": "CRM uses your location for field visit tracking.",
        "NSContactsUsageDescription": "CRM can import contacts from your phone.",
        "NSCameraUsageDescription": "CRM uses the camera to scan business cards.",
        "NSPhotoLibraryUsageDescription": "CRM lets you choose business card images from your photo library.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "associatedDomains": [
        "applinks:4kub.ru"
      ]
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0A0A0A"
      },
      "edgeToEdgeEnabled": true,
      "allowBackup": false,
      "package": "com.fedorportnoi.crm",
      "versionCode": 15,
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.READ_CONTACTS",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "4kub.ru",
              "pathPrefix": "/i"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "blockedPermissions": [
        "android.permission.READ_CALENDAR",
        "android.permission.WRITE_CALENDAR",
        "android.permission.WRITE_CONTACTS",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      [
        "./plugins/withAndroidDisplayName",
        "4КУБ"
      ],
      "expo-router",
      "expo-font",
      "expo-secure-store",
      "expo-notifications",
      "./plugins/withRuStorePush",
      "./plugins/withRuStoreInstallReferrer",
      "expo-background-fetch",
      "expo-task-manager",
      "expo-location",
      [
        "expo-image-picker",
        {
          "photosPermission": "CRM lets you choose business card images from your photo library.",
          "cameraPermission": "CRM uses the camera to scan business cards."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "CRM uses the microphone to record voice messages for the AI assistant."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiUrls": {
        "development": "https://4kub.ru/api/v1"
      },
      "eas": {
        "projectId": "63759f24-3860-43b6-ac4f-cec8180d63c3"
      }
    }
  }
}
