# ============================================================
# Mobile CRM Platform — Environment Variables
# Copy this file to .env and fill in all required values.
# NEVER commit .env to version control.
# ============================================================

# --- Application ---
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug
REQUEST_BODY_LIMIT_BYTES=16777216
# Market profile: RU (Russia — default) or US (United States)
MARKET_CODE=RU
EXPO_PUBLIC_MARKET_CODE=RU

# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql://postgres:password@localhost:5432/crm_db
DB_HOST=localhost
DB_PORT=5432
DB_NAME=crm_db
DB_USER=postgres
DB_PASSWORD=
DB_SSL=false

# --- Yandex Managed PostgreSQL (the production database) ---
# Download the Yandex root CA: https://storage.yandexcloud.net/cloud-certs/CA.pem
# Save it locally and set the path below.
YANDEX_DB_SSL_CA=/path/to/yandex-ca.pem
# For Yandex Managed PostgreSQL, DATABASE_URL takes this form:
# postgresql://user:password@<cluster-host>.mdb.yandexcloud.net:6432/crm_db?sslmode=require&sslrootcert=/path/to/yandex-ca.pem
DIRECT_URL=

DB_POOL_MIN=2
DB_POOL_MAX=10

# --- Redis ---
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- Authentication (JWT) ---
JWT_SECRET=
# Required in production; keep separate from JWT_SECRET because it encrypts provider tokens at rest.
TOKEN_ENCRYPTION_KEY=
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=30d
BCRYPT_ROUNDS=12

# --- Mobile App (Expo) ---
EXPO_PUBLIC_API_URL=http://localhost:3000/api/v1
EXPO_PUBLIC_WS_URL=ws://localhost:3000

# --- Push Notifications ---
# Expo Push (development)
EXPO_ACCESS_TOKEN=

# FCM (Firebase Cloud Messaging — Android, LEGACY — being retired, see PUSH_DUAL_SEND)
FCM_SERVER_KEY=
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_PATH=./firebase-service-account.json

# RuStore Push / VK Push Notification Service (Android shipped via RuStore)
#
# This is the transport that actually reaches the Russian install base. Devices that
# installed the app from RuStore usually have no Google Play Services, and FCM does not
# report that: it accepts the send, returns 200, and delivers nothing. Every reminder and
# chat push to those devices is silently dropped until these two values are set.
#
# Both come from RuStore Console → your app → «Push-уведомления» → «Проекты».
RUSTORE_PROJECT_ID=
RUSTORE_SERVICE_TOKEN=
# Override only to point at a test double. Default: https://vkpns.rustore.ru
RUSTORE_API_BASE_URL=

# The client-side half of the same pairing. Read by src/utils/notifications.ts to decide
# whether an Android build asks RuStore or Expo for its token. Left empty, Android keeps
# registering Expo tokens — i.e. the FCM behaviour this migration exists to replace.
EXPO_PUBLIC_RUSTORE_PROJECT_ID=

# Dual-send window. Default (unset or true): deliver to EVERY registered device row, so a
# phone holding both a RuStore and a legacy Expo/FCM token receives both and the two can be
# compared in the logs (`[push] send … provider=… ok=…`). Set to false only after RuStore
# delivery is proven — it then stops sending to Android fcm/expo rows for any user who has a
# rustore device. iOS and unknown-platform rows are never suppressed.
PUSH_DUAL_SEND=true

# APNS (Apple Push Notification — iOS)
# NOTE: there is no direct APNs transport; iOS delivery goes through the `expo` provider,
# which fronts APNs. These are reserved for a future direct integration.
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_KEY_PATH=./certs/apns.p8

# --- Email Integration ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# --- Yandex Calendar Integration (CalDAV) ---
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
YANDEX_REDIRECT_URI=http://localhost:3000/api/v1/calendar/sync/yandex/callback
YANDEX_CALENDAR_SUCCESS_URL=crm://calendar
# Required in production; send as X-Yandex-Webhook-Secret or Authorization: Bearer <secret>.
YANDEX_WEBHOOK_SECRET=

# --- amoCRM (API v4 / OAuth2) ---
# Credentials of the amoCRM integration registered for this deployment.
AMOCRM_CLIENT_ID=
AMOCRM_CLIENT_SECRET=
# Must exactly match the redirect URI configured in amoCRM.
AMOCRM_REDIRECT_URI=https://your-domain.example/api/v1/amocrm/callback
# Where the mobile/browser flow lands after a successful callback.
AMOCRM_SUCCESS_URL=crm://settings/integrations/amocrm
# Exact public receiver URL. If omitted, PUBLIC_APP_URL + the canonical webhook path is used.
# A per-organization authentication token is appended automatically when subscribing.
AMOCRM_WEBHOOK_URL=https://your-domain.example/api/v1/integrations/amocrm/webhook
# Russian accounts use amocrm.ru. Override only when the connected account lives elsewhere.
AMOCRM_ACCOUNT_HOST=amocrm.ru
AMOCRM_USER_AGENT=4KUB-CRM/1.0
# Sustained rate stays below amoCRM's 7 requests/s integration ceiling.
AMOCRM_RATE_LIMIT_PER_SECOND=5
AMO_WEBHOOK_RATE_LIMIT_MAX=1200
AMO_RECONCILE_HOUR_UTC=3

# --- File Storage (AWS S3 or compatible) ---
S3_BUCKET=crm-uploads
S3_REGION=us-east-1
S3_ENDPOINT=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
MAX_UPLOAD_SIZE_MB=10

# --- Yandex Vision OCR / SpeechKit ---
# Required for business-card OCR from images and voice transcription.
YANDEX_API_KEY=
YANDEX_FOLDER_ID=

# --- Lead intake collector mailbox (Яндекс Бизнес «Заявки» → воронка) ---
# ONE mailbox the platform owns; every organization gets a slice of it through
# plus-addressing ({token} is the org's LeadInbox.intake_token). A user's whole
# setup is pasting their generated address into Яндекс Бизнес notifications.
# The password is a Yandex app password («пароль приложения»), never the
# account password. Orgs may still bring their own mailbox via mode=custom.
LEAD_COLLECTOR_IMAP_HOST=imap.yandex.ru
LEAD_COLLECTOR_IMAP_PORT=993
LEAD_COLLECTOR_IMAP_USER=
LEAD_COLLECTOR_IMAP_PASSWORD=
# Must contain {token}, e.g. 4kub.zayavki+{token}@yandex.ru
LEAD_COLLECTOR_ADDRESS_PATTERN=

# --- AI model provider ---
# Which client serves assistant / contact-ai completions:
#   yandex_foundation_models (default, domestic — names go unmasked)
#   openai (via workers/openai-proxy — FOREIGN: contact aliasing switches on)
# See backend/services/model-provider.ts and model-jurisdiction.ts.
MODEL_PROVIDER=yandex_foundation_models
# Optional OpenAI chat overrides:
#OPENAI_CHAT_MODEL=gpt-4o-mini
#OPENAI_CHAT_TIMEOUT_MS=60000

# --- OpenAI via workers/openai-proxy (chat + voice input) ---
# The Cloudflare Worker's URL and its shared secret — never a real OpenAI key.
# Setup and rotation live in workers/openai-proxy/README.md.
OPENAI_BASE_URL=
OPENAI_PROXY_TOKEN=

# --- AI assistant voice input ---
# A voice recording is personal data that leaves for a US provider and cannot
# be aliased the way chat prompts are (see backend/services/transcription.ts).
# Voice input stays reported as unavailable until this is deliberately "true"
# (owner decision 2026-08-11).
VOICE_INPUT_CROSS_BORDER_OK=false
# Optional overrides: model, ISO-639-1 language hint ("" = autodetect), timeout.
#OPENAI_TRANSCRIBE_MODEL=whisper-1
#OPENAI_TRANSCRIBE_LANGUAGE=ru
#OPENAI_TRANSCRIBE_TIMEOUT_MS=60000

# --- Error Monitoring ---
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# --- Analytics (internal, not customer-facing) ---
MIXPANEL_TOKEN=

# --- Rate Limiting ---
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# --- Deployment-shape settings that security guards actually read -------------
# These exist here because their ABSENCE silently weakens a control, which is
# exactly the failure mode that is hardest to notice.

# The reverse proxy's address. Fastify only honours X-Forwarded-For from this
# hop. LEFT UNSET, request.ip becomes the proxy's own address for every client
# on Earth, and every per-IP rate limit collapses into one global bucket keyed
# 127.0.0.1 — including the 5-per-15-minutes registration limit, which then
# applies to the entire internet at once. Set it to the proxy, never to `true`.
TRUSTED_PROXY=127.0.0.1

# Which model provider this deployment talks to. The ФЗ-152 cross-border gate in
# backend/services/model-jurisdiction.ts reads this and refuses to send personal
# names to anything not on its domestic list. It defaults to the domestic
# provider when unset — so leaving it blank makes the gate a constant `true`
# rather than a decision. Set it explicitly so a repoint has to change it here.
MODEL_PROVIDER=yandex_foundation_models

# Where Yandex sends the OAuth authorization code. MUST be a URL this deployment
# actually owns and MUST match the value registered in the Yandex OAuth app.
# This once pointed at an ephemeral NAT address the project had released, which
# meant authorization codes were being sent to whoever holds that address now.
YANDEX_REDIRECT_URI=https://your-domain.example/api/v1/calendar/sync/yandex/callback

# Comma-separated browser origins allowed to call the API cross-origin.
# Production refuses to boot with this empty — but a non-empty WRONG value is
# accepted silently, so verify it names the origin users actually load.
CORS_ORIGINS=https://your-domain.example
